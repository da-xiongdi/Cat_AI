  "changes": [
    {
      "id": "S2-01",
      "revision": 1,
      "create": false,
      "changes": {
        "title": "训练配置与参数契约",
        "goal": "交付独立训练配置schema、加载校验、有效配置及参数说明，供Python和CLI共用",
        "deliverables": [
          "modeling/config.py及独立schema/加载器",
          "默认与自定义配置示例、模型/特征/参数目录、只校验接口",
          "有效配置与默认/用户值来源、配置失败路径测试"
        ],
        "priority": "high",
        "owner": "Codex",
        "criteria": [
          {
            "id": "C1",
            "description": "独立于项目Settings，支持快照/资格/分区、特征及属性映射版本、模型参数、seed、DOI折数和新输出目录；缺依赖明确提示",
            "required": true
          },
          {
            "id": "C2",
            "description": "baseline_compare锁定默认三模型、3折及预设；custom_train支持单/多模型，至少2折且不超过训练DOI组数；不回退随机行拆分",
            "required": true
          },
          {
            "id": "C3",
            "description": "Ridge alpha、ExtraTrees五项参数及seed有类型/范围/并行限制；Dummy仅mean；未知/泄漏字段、模型、非法值和参数冲突立即拒绝",
            "required": true
          },
          {
            "id": "C4",
            "description": "参数目录、只校验、有效配置及来源可查询，配置示例通过真实加载器；具体要求见S2分解第3节S2-01",
            "required": true
          }
        ]
      },
      "dependencies": [
        "S1B-01"
      ],
      "target_status": "ready"
    },
    {
      "id": "S2-02",
      "revision": 1,
      "create": false,
      "changes": {
        "title": "增强训练与预测集成",
        "goal": "集成S2-01/04/05/06，贯通Python和CLI并完成工程回归与交付清单",
        "deliverables": [
          "Python及配置文件+CLI训练预测入口",
          "帮助、参数说明、可运行训练配置及预测JSON示例",
          "S2工程交付清单、全量回归和接口文档"
        ],
        "priority": "high",
        "owner": "Codex",
        "criteria": [
          {
            "id": "C1",
            "description": "贯通配置校验、指定单/多模型训练、保存/加载、单条/批量预测；baseline/custom独立编号及目录；不依赖Web训练UI",
            "required": true
          },
          {
            "id": "C2",
            "description": "帮助/示例/接口与实际行为一致；非法配置、组数不足、篡改、不支持/零含量物种、越界及混合批量有回归；旧R1包重放通过",
            "required": true
          },
          {
            "id": "C3",
            "description": "全量pytest、ruff check及格式检查通过并固定代码/测试证据；S2工程交付与S3正式比较分开，不以MAE改善为门槛",
            "required": true
          }
        ]
      },
      "dependencies": [
        "S1B-01",
        "S2-01",
        "S2-04",
        "S2-05",
        "S2-06"
      ],
      "target_status": "planned"
    },
    {
      "id": "S2-03",
      "revision": 1,
      "create": false,
      "changes": {
        "title": "家族对照资格检查",
        "goal": "检查可信家族标签及记录/DOI覆盖，形成可比较或跳过报告，不阻断统一模型",
        "deliverables": [
          "家族标签来源与可信范围清单",
          "各家族/分区记录及DOI覆盖和资格/跳过报告"
        ],
        "owner": "Codex",
        "criteria": [
          {
            "id": "C1",
            "description": "核实标准化标签依据，不直接把名称派生的195个material_family原值当成标准分类",
            "required": true
          },
          {
            "id": "C2",
            "description": "分数查看前冻结资格判据，报告各家族各分区记录/DOI数；满足既定分区和DOI CV条件再安排A/B1同特征对照",
            "required": true
          },
          {
            "id": "C3",
            "description": "标签或覆盖不足输出明确跳过原因，不强行按样品名分类，不阻断统一模型，不提前引入B2或专家架构",
            "required": true
          }
        ]
      },
      "dependencies": [
        "S1B-01"
      ],
      "target_status": "ready"
    },
