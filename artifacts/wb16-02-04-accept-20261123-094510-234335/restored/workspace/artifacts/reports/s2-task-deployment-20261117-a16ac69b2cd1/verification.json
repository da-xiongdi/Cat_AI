            "required": true
          },
          {
            "id": "C2",
            "description": "固定有效配置及来源、数据/特征/属性/映射/代码/依赖、折清单、产物哈希及测试记录；工程验收不升级为外推或机理验证",
            "required": true
          }
        ]
