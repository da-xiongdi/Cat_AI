        "deliverables": [
          "固定真实输入的R1/R2默认预设运行与F_base/F1/F2比较报告",
          "OOF、validation和历史test逐条结果/状态、覆盖及配对增量结论"
        ],
        "owner": "Codex",
        "criteria": [
          {
            "id": "C1",
            "description": "同一事实快照、553条共同子集、原分区、相同CV折和配对算法/参数比较F_base/F1/F2；完整绑定校验通过",
            "required": true
          },
          {
            "id": "C2",
            "description": "报告三层结果、共同可支持子集及筛选损失；按全部OOF论文等权MAE选模，validation不选模，test标明历史；F_base胜出如实报告未选用物化增强",
            "required": true
          }
        ]
